{
  "name": "cursor-ultra-notes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cursor Ultra Build Notes — a personal log of apps and projects built with Cursor Ultra.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "css": "tailwindcss -i ./src/styles/input.css -o ./public/styles.css",
    "css:watch": "tailwindcss -i ./src/styles/input.css -o ./public/styles.css --watch",
    "dev": "npm run css && concurrently -k \"npm run css:watch\" \"wrangler dev --port 8787\"",
    "start": "npm run dev",
    "build": "npm run css && wrangler deploy --dry-run --outdir=dist",
    "deploy": "npm run css && wrangler deploy",
    "pages:deploy": "npm run css && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply cursor-ultra-notes --local",
    "db:migrate:remote": "wrangler d1 migrations apply cursor-ultra-notes --remote",
    "db:seed": "tsx scripts/sync-notes.ts",
    "db:setup": "npm run db:migrate && npm run notes:sync",
    "notes:add": "tsx scripts/add-note.ts",
    "notes:sync": "tsx scripts/sync-notes.ts",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.9.9",
    "marked": "^16.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260918.0",
    "@tailwindcss/cli": "^4.1.13",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^24.5.2",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "wrangler": "^4.38.0"
  }
}
