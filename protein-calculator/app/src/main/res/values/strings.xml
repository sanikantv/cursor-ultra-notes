    <string name="disclaimer_title">Medical disclaimer</string>
    <string name="disclaimer_body_1">Protein Calculator &amp; Tracker provides general planning estimates for adults. It is not medical advice, a diagnosis, or a prescription.</string>
    <string name="disclaimer_body_2">The calculator does not set protein targets for kidney disease, liver disease, pregnancy, breastfeeding, or other conditions that need medically supervised nutrition.</string>
    <string name="disclaimer_body_3">A custom factor is only a place to record a number you already have, such as one from a clinician. The app does not present that number as its own recommendation.</string>
    <string name="privacy_title">Privacy information</string>
    <string name="privacy_body_1">This app does not use an account, ads, analytics, or an internet connection. Nothing you enter is sent to a server.</string>
    <string name="privacy_body_2">Onboarding, appearance, units, calculation defaults, and a saved daily goal are stored locally with Android DataStore.</string>
    <string name="about_title">About</string>
    <string name="about_body">Protein Calculator &amp; Tracker helps adults estimate a daily protein planning target from body weight, activity, and a fitness goal. Version %1$s.</string>
