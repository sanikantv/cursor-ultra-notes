    <string name="onboarding_personal_title">Personalized Calculation</string>
    <string name="onboarding_personal_body">Your estimate starts from body weight. Activity and a fitness goal choose one general planning range. Those inputs are not stacked or multiplied, and height is not used as a hidden protein multiplier.</string>
